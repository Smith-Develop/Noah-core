{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/noah-session.js\"",
            "timeout": 10,
            "statusMessage": "Loading Noah Core..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/noah-subagent.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
